<Window x:Class="SharedDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SharedDeck – Shared Cockpit" Width="1180" Height="800" MinWidth="560" MinHeight="600"
        Background="#F4F5F7" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#DDE1E6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6B7A" />
            <Setter Property="Margin" Value="0,2,12,2" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,24,2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- state banner -->
        <Border x:Name="Banner" DockPanel.Dock="Top" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" Background="#5F6B7A">
            <StackPanel>
                <TextBlock x:Name="StateText" Foreground="White" FontSize="18" FontWeight="SemiBold" Text="Nicht verbunden" />
                <TextBlock x:Name="ReasonText" Foreground="White" TextWrapping="Wrap" Opacity="0.9" />
            </StackPanel>
        </Border>

        <!-- update offer, hidden until a newer release exists -->
        <Border x:Name="UpdateCard" DockPanel.Dock="Top" Visibility="Collapsed" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                Background="#E8F0FE" BorderBrush="#2563EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="UpdateNowButton" Content="Jetzt aktualisieren" Click="OnUpdateNow" />
                    <Button x:Name="UpdateLaterButton" Content="Später" Click="OnUpdateLater" Margin="0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <DockPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="UpdateProgressText" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="150" TextAlignment="Right" />
                        <ProgressBar x:Name="UpdateProgress" Height="14" Minimum="0" Maximum="100" />
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- connection -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Host (Kapitän, linker Sitz)" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="Dein Simulator rechnet das Flugzeug. Der Co-Pilot verbindet sich mit deiner Adresse." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="HostButton" Content="Als Host starten" Click="OnHost" />
                        <CheckBox x:Name="StrictBox" Content="Strikter Modus" VerticalAlignment="Center" IsChecked="True"
                                  ToolTip="An: jede nicht freigegebene Abweichung pausiert beide Simulatoren. Aus: Abweichungen werden nur gemeldet (Abstimmung)." />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Co-Pilot (rechter Sitz)" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Text="Adresse des Hosts (IP, Tailscale-Name oder Hostname):" />
                    <!-- the address field takes the remaining width, so the button always stays visible -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="80" MaxWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AddressBox" Padding="4" Margin="0,0,8,0" />
                        <Button x:Name="ConnectButton" Grid.Column="1" Content="Verbinden" Click="OnConnect" Margin="0" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- actions -->
        <!-- wraps into a second row when the window is narrow -->
        <WrapPanel x:Name="ActionBar" DockPanel.Dock="Top" Margin="0,0,0,4">
            <WrapPanel.Resources>
                <!-- space below each button for the second row -->
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
            </WrapPanel.Resources>
            <Button x:Name="StopButton" Content="Trennen" Click="OnStop" />
            <Button x:Name="ResumeButton" Content="Neu synchronisieren und fortsetzen" Click="OnResume" />
            <Button x:Name="AuditButton" Content="A:Var-Audit" Click="OnAudit"
                    ToolTip="Vergleicht zusätzliche Simulator-Variablen beider PCs, um fehlende Einträge in der Konfiguration zu finden." />
            <Button x:Name="AdoptButton" Content="Lokale Variablen freigeben" Click="OnAdopt"
                    ToolTip="Übernimmt die als lokal beschrieben gemeldeten Variablen in die Freigabeliste (Host, wirkt ab der nächsten Verbindung)." />
            <Button Content="Konfiguration öffnen" Click="OnOpenConfig" />
            <Button x:Name="CheckUpdatesButton" Content="Nach Updates suchen" Click="OnCheckUpdates" />
            <Button Content="Protokollordner öffnen" Click="OnOpenLogs"
                    ToolTip="Die Protokolle (eine Datei pro Tag) zum Weitergeben, wenn etwas nicht klappt." />
        </WrapPanel>

        <!-- status -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Simulator" />
                <TextBlock x:Name="BridgeText" Grid.Column="1" Style="{StaticResource Value}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="Gegenstelle" />
                <TextBlock x:Name="PeerText" Grid.Column="3" Style="{StaticResource Value}" />
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Latenz (Hin und zurück)" />
                <TextBlock x:Name="RttText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Label}" Text="Frames pro Sekunde" />
                <TextBlock x:Name="FpsText" Grid.Row="1" Grid.Column="3" Style="{StaticResource Value}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Datenrate (aus / ein)" />
                <TextBlock x:Name="RateText" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Label}" Text="Synchronisierte L:Vars" />
                <TextBlock x:Name="LVarText" Grid.Row="2" Grid.Column="3" Style="{StaticResource Value}" />
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Letzte Prüfung" />
                <TextBlock x:Name="VerifyText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Label}" Text="Gesendete Eingaben" />
                <TextBlock x:Name="InputsText" Grid.Row="3" Grid.Column="3" Style="{StaticResource Value}" />
                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Schubhebel steuert" />
                <TextBlock x:Name="LeversText" Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Label}" Text="Installation" />
                <TextBlock x:Name="InstallText" Grid.Row="4" Grid.Column="3" Style="{StaticResource Value}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- installation problems, hidden when everything is in place -->
        <Border x:Name="InstallWarning" DockPanel.Dock="Top" Visibility="Collapsed" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="SharedDeck ist im Simulator nicht vollständig installiert" />
                <TextBlock x:Name="InstallWarningText" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Bitte SharedDeck-Setup.exe mit den SharedDeck-A32NX-ZIP-Teilen ausführen und MSFS danach neu starten. Ohne den SharedDeck-A32NX kann sich die App nicht mit dem Simulator verbinden." />
            </StackPanel>
        </Border>

        <!-- details -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Abweichungen" Margin="0,0,0,6" />
                    <ListBox x:Name="MismatchList" BorderThickness="0" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Auf dem Co-Pilot-PC lokal beschrieben" Margin="0,0,0,6" />
                    <ListBox x:Name="ContestedList" BorderThickness="0" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Protokoll" Margin="0,0,0,6" />
                    <ListBox x:Name="LogList" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
