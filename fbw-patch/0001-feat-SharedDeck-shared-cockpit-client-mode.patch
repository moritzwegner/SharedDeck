index 0000000..1d47247
--- /dev/null
+++ b/fbw-a32nx/src/systems/extras-host/modules/shareddeck/SharedDeckBridge.ts
@@ -0,0 +1,173 @@
+// Copyright (c) 2026 FlyByWire Simulations
+// SPDX-License-Identifier: GPL-3.0
+
+import { EventBus, HEvent, Instrument } from '@microsoft/msfs-sdk';
+import { AircraftGithubVersionChecker } from '@flybywiresim/fbw-sdk';
+
+interface GenericDataListener extends ViewListener.ViewListener {
+  onDataReceived(key: string, callback: (data: any) => void): void;
+  send(key: string, data: any): void;
+}
+
+declare function RegisterGenericDataListener(callback?: () => void): GenericDataListener;
+
+interface EventBusPackage {
+  busId?: number;
+  packagedId: number;
+  data: { topic: string; data: unknown; isCached?: boolean }[];
+}
+
+type BridgeMode = 'off' | 'host' | 'client';
+
+/**
+ * Connects this simulator to the SharedDeck app (shared cockpit).
+ *
+ * - relays messages between the SharedDeck WASM module (CommBus) and the app (WebSocket)
+ * - mirrors the EventBus sync channels between the instruments of host and client, so data that
+ *   only exists in JS (flight plan, ND symbols, MCDU screen) reaches the client
+ * - forwards the H events of the client pilot to the host, where they are executed
+ */
+export class SharedDeckBridge implements Instrument {
+  private static readonly URL = 'ws://127.0.0.1:8391/';
+
+  private static readonly RECONNECT_INTERVAL_MS = 5000;
+
+  /** msfs-sdk EventBus sync and the FBW GenericDataListenerSync channel (ND symbols, failures, TCAS) */
+  private static readonly EVENT_BUS_KEYS = ['wt.eb.evt', 'EB_EVENTS'];
+
+  private static readonly MAX_REMEMBERED_PACKAGES = 512;
+
+  private readonly busId = Math.floor(Math.random() * Number.MAX_SAFE_INTEGER);
+
+  private readonly injectedPackages = new Set<number>();
+
+  private readonly injectedOrder: number[] = [];
+
+  private socket: WebSocket | null = null;
+
+  private mode: BridgeMode = 'off';
+
+  private buildVersion = 'unknown';
+
+  private commBus: ViewListener.ViewListener | null = null;
+
+  private dataListener: GenericDataListener | null = null;
+
+  constructor(private readonly bus: EventBus) {}
+
+  public init(): void {
+    AircraftGithubVersionChecker.getBuildInfo('a32nx')
+      .then((info) => (this.buildVersion = `${info.version}+${info.sha.substring(0, 8)}`))
+      .catch(() => (this.buildVersion = 'unknown'))
+      .finally(() => this.connect());
+
+    this.commBus = RegisterViewListener('JS_LISTENER_COMM_BUS', undefined, false);
+    this.commBus.on('SHAREDDECK_FROM_WASM', (data: string) => this.send({ ch: 'wasm', d: data }));
+
+    const dataListener = RegisterGenericDataListener(() => {
+      for (const key of SharedDeckBridge.EVENT_BUS_KEYS) {
+        dataListener.onDataReceived(key, (data: EventBusPackage) => this.onEventBusPackage(key, data));
+      }
+    });
+    this.dataListener = dataListener;
+
+    this.bus
+      .getSubscriber<HEvent>()
+      .on('hEvent')
+      .handle((name) => {
+        if (this.mode === 'client') {
+          this.send({ ch: 'h', n: name });
+        }
+      });
+  }
+
+  public onUpdate(): void {
+    // event driven
+  }
+
+  private connect(): void {
+    const socket = new WebSocket(SharedDeckBridge.URL);
+    this.socket = socket;
+    socket.onopen = () => {
+      this.send({ ch: 'bridge', version: this.buildVersion, aircraft: SimVar.GetSimVarValue('TITLE', 'string') });
+    };
+    socket.onmessage = (event) => this.onAppMessage(String(event.data));
+    socket.onclose = () => {
+      this.socket = null;
+      this.mode = 'off';
+      setTimeout(() => this.connect(), SharedDeckBridge.RECONNECT_INTERVAL_MS);
+    };
+    socket.onerror = () => {
+      // onclose follows and reconnects; the app is not always running
+    };
+  }
+
+  private send(message: object): void {
+    if (this.socket && this.socket.readyState === WebSocket.OPEN) {
+      this.socket.send(JSON.stringify(message));
+    }
+  }
+
+  private onAppMessage(text: string): void {
+    let message: any;
+    try {
+      message = JSON.parse(text);
+    } catch {
+      return;
+    }
+
+    switch (message.ch) {
+      case 'wasm':
+        Coherent.call('COMM_BUS_WASM_CALLBACK', 'SHAREDDECK_TO_WASM', message.d);
+        break;
+      case 'eb':
+        this.injectEventBusPackage(message.k, message.pkg);
+        break;
+      case 'h':
+        // an H event of the client pilot, executed here on the host
+        if (this.mode === 'host') {
+          SimVar.SetSimVarValue(`H:${message.n}`, 'number', 0);
+        }
+        break;
+      case 'mode':
+        this.mode = message.role;
+        break;
+      case 'resync':
+        // all instruments publish their cached synced events again, and the FMS its full flight plans,
+        // so a new client gets the full state
+        this.bus.pub('event_bus', 'resync_request', true, false);
+        this.bus.pub('flightPlanManager.syncRequest', undefined, true, false);
+        // the failures orchestrator (flyPad) broadcasts its active failures on request
+        this.injectEventBusPackage('EB_EVENTS', {
+          packagedId: 0,
+          data: [{ topic: 'FBW_FAILURE_REQUEST', data: undefined }],
+        });
+        break;
+    }
+  }
+
+  private onEventBusPackage(key: string, eventBusPackage: EventBusPackage): void {
+    if (this.mode === 'off' || !eventBusPackage || this.injectedPackages.has(eventBusPackage.packagedId)) {
+      return;
+    }
+    this.send({ ch: 'eb', k: key, pkg: eventBusPackage });
+  }
+
+  private injectEventBusPackage(key: string, eventBusPackage: EventBusPackage): void {
+    if (this.mode === 'off' || !this.dataListener || !SharedDeckBridge.EVENT_BUS_KEYS.includes(key)) {
+      return;
+    }
+    // a new identity so the receiving buses neither drop it as their own nor as a duplicate
+    eventBusPackage.packagedId = Math.floor(Math.random() * 1000000000);
+    if (eventBusPackage.busId !== undefined) {
+      eventBusPackage.busId = this.busId;
+    }
+    this.injectedPackages.add(eventBusPackage.packagedId);
+    this.injectedOrder.push(eventBusPackage.packagedId);
+    const forgotten = this.injectedOrder.length > SharedDeckBridge.MAX_REMEMBERED_PACKAGES ? this.injectedOrder.shift() : undefined;
+    if (forgotten !== undefined) {
+      this.injectedPackages.delete(forgotten);
+    }
+    this.dataListener.send(key, eventBusPackage);
+  }
+}
