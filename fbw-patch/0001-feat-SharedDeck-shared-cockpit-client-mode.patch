+++ b/fbw-a32nx/src/systems/shared/src/SharedDeck.ts
@@ -0,0 +1,48 @@
+// Copyright (c) 2026 FlyByWire Simulations
+// SPDX-License-Identifier: GPL-3.0
+
+/**
+ * Role of this simulator in a SharedDeck shared cockpit session, set by the SharedDeck module.
+ * On the client every system is computed by the host and mirrored into this simulator, so
+ * components that compute state must not run there.
+ */
+export enum SharedDeckRole {
+  Off = 0,
+  Client = 1,
+  Host = 2,
+}
+
+export class SharedDeck {
+  public static role(): SharedDeckRole {
+    return SimVar.GetSimVarValue('L:SHAREDDECK_ROLE', 'number') ?? SharedDeckRole.Off;
+  }
+
+  public static isClient(): boolean {
+    return SharedDeck.role() === SharedDeckRole.Client;
+  }
+
+  public static isHost(): boolean {
+    return SharedDeck.role() === SharedDeckRole.Host;
+  }
+}
+
+/** EventBus topic with the MCDU screen content of the host, rendered by the client MCDU. */
+export const SHAREDDECK_MCDU_SCREEN_TOPIC = 'shareddeck_mcdu_screen';
+
+export interface SharedDeckMcduScreen {
+  title: string;
+  pageCurrent: number;
+  pageCount: number;
+  /** [row][column] markup strings and class names */
+  labels: string[][];
+  labelClasses: string[][];
+  lines: string[][];
+  lineClasses: string[][];
+  scratchpadText: string;
+  scratchpadColor: string;
+  arrows: boolean[];
+}
+
+export interface SharedDeckMcduEvents {
+  [SHAREDDECK_MCDU_SCREEN_TOPIC]: SharedDeckMcduScreen;
+}
