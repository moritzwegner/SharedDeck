+  /**
+   * SharedDeck host: publishes the screen content (at most every 100 ms, only when changed) for the client's MCDU.
+   * @param deltaTime time since the last update in ms
+   */
+  public publishSharedDeckScreen(deltaTime: number) {
+    if (this.sharedDeckPublishThrottler.canUpdate(deltaTime) === -1 || !this._titleElement) {
+      return;
+    }
+    const screen: SharedDeckMcduScreen = {
+      title: this._title ?? '',
+      pageCurrent: this._pageCurrent ?? 0,
+      pageCount: this._pageCount ?? 0,
+      labels: this._labelElements.map((row, i) => row.map((_, j) => this._labels[i]?.[j] ?? '')),
+      labelClasses: this._labelElements.map((row) => row.map((element) => element.className)),
+      lines: this._lineElements.map((row, i) => row.map((_, j) => this._lines[i]?.[j] ?? '')),
+      lineClasses: this._lineElements.map((row) => row.map((element) => element.className)),
+      scratchpadText: this.scratchpadDisplay.getText() ?? '',
+      scratchpadColor: this.scratchpadDisplay.getColor(),
+      arrows: [...this._arrows],
+    };
+    const serialized = JSON.stringify(screen);
+    if (serialized !== this.sharedDeckLastScreen) {
+      this.sharedDeckLastScreen = serialized;
+      this.bus.getPublisher<SharedDeckMcduEvents>().pub(SHAREDDECK_MCDU_SCREEN_TOPIC, screen, true, true);
+    }
+  }
+
+  /** Maps a key of the PC keyboard to the MCDU button it stands for (SharedDeck client). */
+  private static sharedDeckKeyboardButton(keyCode: number): string | undefined {
+    if (keyCode >= KeyCode.KEY_A && keyCode <= KeyCode.KEY_Z) {
+      return String.fromCharCode(keyCode);
+    }
+    if (keyCode >= KeyCode.KEY_0 && keyCode <= KeyCode.KEY_9) {
+      return String.fromCharCode(keyCode);
+    }
+    if (keyCode >= KeyCode.KEY_NUMPAD0 && keyCode <= KeyCode.KEY_NUMPAD9) {
+      return String(keyCode - KeyCode.KEY_NUMPAD0);
+    }
+    switch (keyCode) {
+      case KeyCode.KEY_SPACE:
+        return 'SP';
+      case KeyCode.KEY_SLASH:
+      case KeyCode.KEY_DIVIDE:
+        return 'DIV';
+      case KeyCode.KEY_PERIOD:
+      case KeyCode.KEY_DECIMAL:
+        return 'DOT';
+      case KeyCode.KEY_SUBTRACT:
+      case KeyCode.KEY_ADD:
+      case A320_Neo_CDU_MainDisplay.KEY_CODE_DASH:
+        return 'PLUSMINUS';
+      case KeyCode.KEY_BACK_SPACE:
+      case KeyCode.KEY_DELETE:
+        return 'CLR';
+      default:
+        return undefined;
+    }
+  }
+
+  /** SharedDeck client: renders the screen content of the host's MCDU. */
+  private applySharedDeckScreen(screen: SharedDeckMcduScreen) {
+    if (!this._titleElement) {
+      return;
+    }
+    const render = (element: HTMLElement, markup: string, className?: string) => {
+      if (className !== undefined) {
+        element.className = className;
+      }
+      element.textContent = markup;
+      element.innerHTML = this._formatCell(element.innerHTML);
+    };
+
+    this._title = screen.title;
+    render(this._titleElement, screen.title);
+    this.setPageCurrent(screen.pageCurrent);
+    this.setPageCount(screen.pageCount);
+    for (let i = 0; i < this._labelElements.length; i++) {
+      this._labels[i] = [];
+      this._lines[i] = [];
